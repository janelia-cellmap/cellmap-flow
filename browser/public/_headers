# Cloudflare Pages / Netlify-style _headers file.
# Copied verbatim by Vite from public/ into dist/.

/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

# COOP/COEP gives the in-browser BMZ path the cross-origin isolation it
# needs for SharedArrayBuffer / threaded WASM. The server-backed flow
# doesn't need these but they're harmless when set globally.
